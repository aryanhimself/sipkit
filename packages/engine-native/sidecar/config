#
# baresip config for the sipkit native SIP engine sidecar (headless).
# The engine drives everything over ctrl_tcp; accounts are created at runtime.
#

# Core
poll_method		epoll

# SIP
sip_listen		0.0.0.0:5060
sip_trans_def		udp
sip_verify_server	no

# Call
call_local_timeout	120
call_max_calls		4
call_hold_other_calls	no

# Audio: headless devices. Production builds use the OS audio module instead
# (coreaudio / wasapi / pulse), see docs/native-engine.md.
audio_player		aufile,/dev/null
audio_source		ausine,440
audio_alert		aufile,/dev/null
audio_level		no
ausrc_format		s16
auplay_format		s16
auenc_format		s16
audec_format		s16
audio_buffer		20-160

# RTP
rtp_tos			184
rtp_ports		10100-10199
rtp_timeout		0

# Network
net_af			ipv4

# Modules
module_path		/opt/baresip/lib/baresip/modules
module			g711.so
module			ausine.so
module			aufile.so

module_app		menu.so
module_app		ctrl_tcp.so

# Module parameters
ctrl_tcp_listen		0.0.0.0:4444
menu_bell		no
