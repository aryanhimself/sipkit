# sipkit push service. Copy to .env (never commit real values).
# Generate keys + secrets:  pnpm --filter sipkit-push-service gen:vapid

# VAPID key pair (P-256). The public key is served at GET /vapid-public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:).
VAPID_SUBJECT=mailto:ops@sipkit.example

# HMAC secret (>= 32 chars) shared with the CRM backend that mints agent tokens
# (skp1.<payload>.<sig>, see docs/push.md) and used to sign per-call decline links.
PUSH_TOKEN_SECRET=
# Development only: a static bearer token accepted for ANY extension. Leave empty in production.
PUSH_DEV_TOKEN=
# Shared secret Asterisk sends as X-Sipkit-Push-Secret on /notify/* and /calls/:id/status.
PUSH_NOTIFY_SECRET=

PORT=8790
# JSON file store (empty = memory only).
PUSH_STORE_FILE=./data/subscriptions.json
# Comma separated origins allowed to call the API from a browser, or *.
PUSH_CORS_ORIGINS=*
# Public URL browsers use to reach this service (optional; adds an absolute decline URL to pushes).
PUSH_PUBLIC_URL=
# Seconds a call notification lives (Web Push TTL) - match the dialplan wait.
PUSH_CALL_TTL=45
PUSH_MAX_PER_EXTENSION=10
# Accepted push service hosts (comma separated). Default: FCM, Mozilla, Apple, Windows.
# PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
# Tests only: accept http:// and private push endpoints (local fake push server).
PUSH_ALLOW_INSECURE_ENDPOINTS=0
# Expose GET /debug/events (needs X-Sipkit-Push-Secret).
PUSH_DEBUG=0
