# voicemail-api (services/voicemail-api). Copy to .env and fill in. Never commit real values.
PORT=8090
HOST=0.0.0.0
# app_voicemail file spool (shared with Asterisk, read-write).
VM_SPOOL_DIR=/var/spool/asterisk/voicemail
# Context used when a request names a bare mailbox ("1001" = "1001@default").
VM_DEFAULT_CONTEXT=default
# Comma-separated browser origins allowed by CORS (exact match), e.g. https://crm.example.com
VM_CORS_ORIGINS=http://localhost:5179
# HMAC-SHA256 secret shared with the CRM backend, which mints short-lived per-mailbox tokens
# (docs/voicemail.md, "Tokens"). At least 32 characters. Generate: openssl rand -hex 32
VM_TOKEN_SECRET=
# Longest token lifetime accepted (seconds).
VM_TOKEN_MAX_TTL=86400
# Static per-mailbox tokens, "mailbox[@context]=token" comma-separated (dev / simple setups).
VM_STATIC_TOKENS=
# DEV ONLY: one token valid for EVERY mailbox. Leave empty in production.
VM_DEV_TOKEN=
# Optional AMI login used to send VoicemailRefresh after a move/delete so MWI updates at once.
# Without it, Asterisk's voicemail.conf pollmailboxes=yes picks the change up within pollfreq.
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=
AMI_SECRET=
