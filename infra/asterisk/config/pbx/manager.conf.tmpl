; AMI (Asterisk Manager Interface) for the dev PBX. Used by services/voicemail-api
; to send VoicemailRefresh after it moves or deletes a message, so MWI updates at
; once instead of after the next pollmailboxes scan (docs/voicemail.md).
; Port 5038 is NOT published by docker-compose: only containers on the voip
; network can reach it. Development use only.
[general]
enabled=yes
port=5038
bindaddr=0.0.0.0
displayconnects=no

; voicemail-api: may only send "user"-class actions (VoicemailRefresh), reads nothing.
; The secret is the dev SIP password (DEV_SIP_PASSWORD), never committed.
[sipkit-voicemail]
secret=${DEV_SIP_PASSWORD}
deny=0.0.0.0/0.0.0.0
permit=${LOCAL_NET}
read=
write=user
