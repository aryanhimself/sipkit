# Copy to .env and adjust. docker compose reads .env from this directory.

# Address that browsers / softphones use to reach the containers' RTP ports.
# 127.0.0.1 works when the browser runs on the same machine as Docker.
# Use your LAN IP (e.g. 192.168.1.50) to test from a phone or another PC.
EXTERNAL_IP=127.0.0.1

# Password for ALL dev PBX accounts (1001, 1002, 2001, 2002, 2099). Dev only.
DEV_SIP_PASSWORD=sipkitdev123

# ---- gateway profile -------------------------------------------------------
# Account the browser registers with on the gateway (wss://localhost:8189/ws).
GW_BROWSER_USER=1001
GW_BROWSER_PASSWORD=sipkitdev123

# Upstream plain-SIP PBX. Defaults point at the dev PBX container (account 2099),
# so the gateway works out of the box. Replace with your real PBX + account.
UPSTREAM_HOST=172.28.0.10
UPSTREAM_PORT=5060
UPSTREAM_DOMAIN=172.28.0.10
UPSTREAM_USER=2099
UPSTREAM_PASSWORD=sipkitdev123
UPSTREAM_CODECS=ulaw,alaw

# ---- coturn (gateway / turn profiles) -------------------------------------------
TURN_USER=sipkit
TURN_PASSWORD=sipkitturn-dev
TURN_REALM=sipkit.local
