{
  "name": "sipkit-desktop",
  "productName": "SipKit",
  "private": true,
  "version": "0.1.0",
  "description": "SipKit desktop app (Electron shell around sipkit-ui)",
  "author": "sipkit contributors",
  "type": "module",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node --experimental-strip-types scripts/gen-icons.mjs",
    "package": "pnpm build && electron-builder --config electron-builder.config.cjs --publish never",
    "package:dir": "pnpm build && electron-builder --config electron-builder.config.cjs --dir --publish never"
  },
  "devDependencies": {
    "sipkit-core": "workspace:*",
    "sipkit-react": "workspace:*",
    "sipkit-ui": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
