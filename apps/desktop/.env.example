# SipKit desktop app: environment variables (see docs/desktop.md).
# Never commit real values. In CI these come from repository secrets / variables.

# --- Auto-update ------------------------------------------------------------
# HTTPS base URL of the generic update feed (latest.yml, latest-mac.yml and the
# installers uploaded from dist/release). At build time it is written into the
# app (app-update.yml); at runtime it overrides that. Unset = no auto-update.
SIPKIT_UPDATE_URL=
# SIPKIT_UPDATE_DISABLED=1

# --- macOS signing (electron-builder) -----------------------------------------
# Developer ID Application certificate: base64 .p12, file path or https URL.
CSC_LINK=
CSC_KEY_PASSWORD=
# Or the name of an identity already in the login keychain:
# CSC_NAME=Developer ID Application: Your Name (TEAMID)
# Force an unsigned build:
# CSC_IDENTITY_AUTO_DISCOVERY=false

# --- macOS notarization (one of the two sets) ---------------------------------
# App Store Connect API key (recommended):
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Apple ID + app-specific password:
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# --- Windows signing ----------------------------------------------------------
# Authenticode certificate (.pfx): base64, file path or https URL.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
# Publisher name shown by Windows (must match the certificate subject CN).
WIN_PUBLISHER_NAME=

# --- Development / tests only -------------------------------------------------
# SIPKIT_DESKTOP_ENGINE=mock          # mock | sipjs (overrides settings.engine)
# SIPKIT_DESKTOP_USER_DATA=/tmp/sipkit   # separate profile (and single-instance lock)
# SIPKIT_DESKTOP_REGISTER_PROTOCOLS=1 # let a dev build become the tel:/sip: handler
# SIPKIT_DESKTOP_TEST=1               # e2e: in-memory key store, test hooks, no OS notifications
